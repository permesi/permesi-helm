{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "socketPath": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "pattern": "^(error|warn|info|debug|trace|[0-5])$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dsn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "externalSecret": {
              "$ref": "#/definitions/externalSecretRef"
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pemBundlePath": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "externalSecret": {
          "$ref": "#/definitions/externalSecretRef"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paserkUrl": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "paserkCaPath": {
          "type": "string"
        },
        "paserkCa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "minLength": 1
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "externalSecret": {
              "$ref": "#/definitions/externalSecretRef"
            }
          }
        }
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "externalSecret": {
          "$ref": "#/definitions/vaultExternalSecretRef"
        },
        "roleId": {
          "$ref": "#/definitions/envSource"
        },
        "secretId": {
          "$ref": "#/definitions/envSource"
        },
        "wrappedToken": {
          "$ref": "#/definitions/envSource"
        },
        "kvMount": {
          "type": "string"
        },
        "kvPath": {
          "type": "string"
        },
        "transitMount": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontendBaseUrl": {
          "type": "string"
        },
        "corsAllowedOrigins": {
          "type": "string",
          "description": "Comma-separated list of additional CORS allowed origins"
        },
        "emailTokenTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "emailResendCooldownSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "emailOutboxPollSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "emailOutboxBatchSize": {
          "type": "integer",
          "minimum": 1
        },
        "emailOutboxMaxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "emailOutboxBackoffBaseSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "emailOutboxBackoffMaxSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "opaqueServerId": {
          "type": "string"
        },
        "opaqueLoginTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "platformAdminTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "platformRecentAuthSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "additionalProperties": true
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "store": {
          "type": "string"
        },
        "storeKind": {
          "type": "string",
          "enum": ["SecretStore", "ClusterSecretStore"]
        },
        "refreshInterval": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "envSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "externalSecretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remoteKey": {
          "type": "string"
        },
        "remoteProperty": {
          "type": "string"
        }
      }
    },
    "vaultExternalSecretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remoteKey": {
          "type": "string"
        },
        "roleIdProperty": {
          "type": "string"
        },
        "secretIdProperty": {
          "type": "string"
        }
      }
    }
  }
}
